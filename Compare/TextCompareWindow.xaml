<Window x:Class="ByteCommander.Compare.TextCompareWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:ByteCommander.Compare"
        x:Name="Self" Width="1360" Height="840" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" UseLayoutRounding="True"
        PreviewKeyDown="Window_PreviewKeyDown" Closing="Window_Closing">
    <Window.Resources>
        <!-- Рядок порівняння: без виділення фоном (фон показує тип відмінності), поточний рядок — рамка -->
        <Style x:Key="DiffRowContainer" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" BorderThickness="0,1" BorderBrush="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Панель інструментів -->
        <WrapPanel DockPanel.Dock="Top" Margin="8,8,8,4">
            <Button Style="{StaticResource IconButton}" Content="&#xE70E;" ToolTip="Попередня відмінність (Shift+F8, Ctrl+P, Alt+↑)" Click="Prev_Click"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE70D;" ToolTip="Наступна відмінність (F8, Ctrl+N, Alt+↓)" Click="Next_Click"/>
            <Border Width="1" Background="{DynamicResource LineBrush}" Margin="6,7"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE72A;" ToolTip="Перенести блок зліва направо (Alt+→)" Click="CopyRight_Click"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE72B;" ToolTip="Перенести блок справа наліво (Alt+←)" Click="CopyLeft_Click"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE74E;" ToolTip="Зберегти змінені файли (Ctrl+S)" Click="Save_Click"/>
            <Border Width="1" Background="{DynamicResource LineBrush}" Margin="6,7"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE8AB;" ToolTip="Поміняти сторони місцями" Click="Swap_Click"/>
            <Button Style="{StaticResource IconButton}" Content="&#xE72C;" ToolTip="Перечитати файли (F5)" Click="Reload_Click"/>
            <Border Width="1" Background="{DynamicResource LineBrush}" Margin="6,7"/>
            <CheckBox x:Name="IgnoreWhitespaceBox" Content="Ігнорувати пробіли" VerticalAlignment="Center" Margin="8,0,14,0" Click="Options_Click"/>
            <CheckBox x:Name="IgnoreCaseBox" Content="Ігнорувати регістр" VerticalAlignment="Center" Margin="0,0,14,0" Click="Options_Click"/>
            <CheckBox x:Name="OnlyDiffsBox" Content="Лише відмінності" VerticalAlignment="Center" Margin="0,0,14,0" Click="OnlyDiffs_Click"/>
        </WrapPanel>

        <!-- Заголовки сторін -->
        <Grid DockPanel.Dock="Top" Margin="8,0,8,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10,5">
                <TextBlock x:Name="LeftHeader" TextTrimming="CharacterEllipsis"/>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource PanelBrush}" CornerRadius="6" Padding="10,5">
                <TextBlock x:Name="RightHeader" TextTrimming="CharacterEllipsis"/>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" DockPanel.Dock="Bottom" Margin="12,5,12,7" Foreground="{DynamicResource TextDimBrush}"/>
        <ScrollBar x:Name="HBar" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="8,2,8,0" Minimum="0" SmallChange="20" LargeChange="200"
                   ValueChanged="HBar_ValueChanged"/>

        <Grid Margin="8,0,8,0">
            <!-- Двійкові файли -->
            <Border x:Name="BinaryPanel" Visibility="Collapsed" Background="{DynamicResource PanelBrush}" CornerRadius="8" Padding="24">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock x:Name="BinaryText" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,16"/>
                    <Button x:Name="HexButton" Content="Відкрити обидва в hex" HorizontalAlignment="Center" Click="Hex_Click"/>
                </StackPanel>
            </Border>

            <Border x:Name="TextPanel" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource LineBrush}"
                    Background="{DynamicResource InputBrush}" ClipToBounds="True">
                <ListBox x:Name="Rows" ItemContainerStyle="{StaticResource DiffRowContainer}" SelectionMode="Single"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Item" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         FontFamily="{StaticResource MonoFont}" FontSize="13" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type c:DiffRow}">
                            <Grid Height="20">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="2"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="L" Grid.Column="0" Background="Transparent">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Width="58" Text="{Binding LeftNumber}" TextAlignment="Right"
                                                   Padding="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/>
                                        <Border ClipToBounds="True">
                                            <c:DiffLineText Line="{Binding LeftText}" HighlightStart="{Binding HighlightStartLeft}"
                                                            HighlightLength="{Binding HighlightLengthLeft}" VerticalAlignment="Center"
                                                            Offset="{Binding HOffset, ElementName=Self}"/>
                                        </Border>
                                    </DockPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource LineBrush}"/>
                                <Border x:Name="R" Grid.Column="2" Background="Transparent">
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Width="58" Text="{Binding RightNumber}" TextAlignment="Right"
                                                   Padding="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextDimBrush}"/>
                                        <Border ClipToBounds="True">
                                            <c:DiffLineText Line="{Binding RightText}" HighlightStart="{Binding HighlightStartRight}"
                                                            HighlightLength="{Binding HighlightLengthRight}" VerticalAlignment="Center"
                                                            Offset="{Binding HOffset, ElementName=Self}"/>
                                        </Border>
                                    </DockPanel>
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Changed">
                                    <Setter TargetName="L" Property="Background" Value="{DynamicResource DiffChangedBrush}"/>
                                    <Setter TargetName="R" Property="Background" Value="{DynamicResource DiffChangedBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Deleted">
                                    <Setter TargetName="L" Property="Background" Value="{DynamicResource DiffDeletedBrush}"/>
                                    <Setter TargetName="R" Property="Background" Value="{DynamicResource DiffFillerBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Inserted">
                                    <Setter TargetName="L" Property="Background" Value="{DynamicResource DiffFillerBrush}"/>
                                    <Setter TargetName="R" Property="Background" Value="{DynamicResource DiffAddedBrush}"/>
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Border>
        </Grid>
    </DockPanel>
</Window>
