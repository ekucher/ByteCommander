<UserControl x:Class="ByteCommander.Controls.FilePanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border x:Name="Root" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource LineBrush}"
            BorderThickness="1" CornerRadius="8">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Вкладки -->
            <DockPanel Grid.Row="0" Margin="6,6,6,0">
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="&#xE710;" FontSize="11"
                        Padding="8,5" ToolTip="Нова вкладка (Ctrl+T)" Click="NewTab_Click"/>
                <ScrollViewer x:Name="TabsScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Focusable="False">
                    <ItemsControl x:Name="TabsList" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border x:Name="TabBd" CornerRadius="6" Padding="10,3,3,3" Margin="0,0,3,0" Background="Transparent"
                                        MouseLeftButtonDown="Tab_MouseLeftButtonDown" MouseUp="Tab_MouseUp" ToolTip="{Binding Location}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock x:Name="TabIcon" Text="&#xE8B7;" FontFamily="{StaticResource IconFont}" FontSize="12"
                                                   VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{StaticResource TextDimBrush}"/>
                                        <TextBlock x:Name="TabText" Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="170"
                                                   TextTrimming="CharacterEllipsis" Foreground="{StaticResource TextDimBrush}"/>
                                        <Button Style="{StaticResource TabCloseButton}" Content="&#xE711;" Click="TabClose_Click"
                                                Margin="6,0,0,0" ToolTip="Закрити (Ctrl+W)"/>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="TabBd" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="TabBd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsActive}" Value="True">
                                        <Setter TargetName="TabBd" Property="Background" Value="{StaticResource TabActiveBrush}"/>
                                        <Setter TargetName="TabText" Property="Foreground" Value="{StaticResource TextBrush}"/>
                                        <Setter TargetName="TabIcon" Property="Foreground" Value="{StaticResource AccentBrush}"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- Диск + хлібні крихти + вільне місце -->
            <Grid Grid.Row="1" Margin="6,6,6,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button x:Name="DriveButton" Padding="8,4" Click="DriveButton_Click" Focusable="False"
                        ToolTip="Вибір диска (Alt+F1 / Alt+F2)">
                    <StackPanel Orientation="Horizontal">
                        <Image x:Name="DriveIcon" Width="16" Height="16" Margin="0,0,6,0"/>
                        <TextBlock x:Name="DriveText" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        <TextBlock Text="&#xE70D;" FontFamily="{StaticResource IconFont}" FontSize="9" Margin="7,1,0,0"
                                   VerticalAlignment="Center" Foreground="{StaticResource TextDimBrush}"/>
                    </StackPanel>
                </Button>
                <Border Grid.Column="1" x:Name="PathBorder" Margin="6,0" CornerRadius="6" Background="{StaticResource InputBrush}"
                        BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Cursor="IBeam"
                        MouseLeftButtonDown="PathBorder_MouseLeftButtonDown" ToolTip="Клацніть, щоб ввести шлях (Ctrl+L)">
                    <Grid>
                        <ScrollViewer x:Name="CrumbScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                                      Focusable="False" Margin="2,0">
                            <StackPanel x:Name="CrumbPanel" Orientation="Horizontal" VerticalAlignment="Center"/>
                        </ScrollViewer>
                        <TextBox x:Name="PathBox" Visibility="Collapsed" BorderThickness="0" Background="Transparent"
                                 VerticalContentAlignment="Center" Padding="6,3"
                                 KeyDown="PathBox_KeyDown" LostKeyboardFocus="PathBox_LostKeyboardFocus"/>
                    </Grid>
                </Border>
                <TextBlock Grid.Column="2" x:Name="FreeText" VerticalAlignment="Center" FontSize="12" Margin="2,0,4,0"
                           Foreground="{StaticResource TextDimBrush}"/>
            </Grid>

            <!-- Фільтр (Ctrl+F) -->
            <Border Grid.Row="2" x:Name="FilterBar" Visibility="Collapsed" Margin="6,0,6,6">
                <DockPanel>
                    <TextBlock Text="&#xE71C;" FontFamily="{StaticResource IconFont}" Foreground="{StaticResource AccentBrush}"
                               VerticalAlignment="Center" Margin="4,0,8,0"/>
                    <TextBox x:Name="FilterBox" TextChanged="FilterBox_TextChanged" PreviewKeyDown="FilterBox_PreviewKeyDown"
                             ToolTip="Фільтр за частиною імені · Esc — закрити"/>
                </DockPanel>
            </Border>

            <!-- Список файлів -->
            <ListView Grid.Row="3" x:Name="List" Margin="3,0" SelectionMode="Single" ItemContainerStyle="{StaticResource FileRow}"
                      VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                      IsTextSearchEnabled="False" AllowDrop="True"
                      PreviewKeyDown="List_PreviewKeyDown" PreviewTextInput="List_PreviewTextInput"
                      MouseDoubleClick="List_MouseDoubleClick"
                      PreviewMouseLeftButtonDown="List_PreviewMouseLeftButtonDown"
                      PreviewMouseLeftButtonUp="List_PreviewMouseLeftButtonUp"
                      PreviewMouseMove="List_PreviewMouseMove"
                      PreviewMouseDown="List_PreviewMouseDown"
                      MouseRightButtonUp="List_MouseRightButtonUp"
                      DragOver="List_DragOver" Drop="List_Drop"
                      SizeChanged="List_SizeChanged"
                      GridViewColumnHeader.Click="Header_Click">
                <ListView.View>
                    <GridView AllowsColumnReorder="False">
                        <GridViewColumn x:Name="ColName" Header="Ім’я" Width="260">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Image DockPanel.Dock="Left" Source="{Binding Icon}" Width="16" Height="16" Margin="0,0,7,0"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="ColExt" Header="Тип" Width="58">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Extension}" Opacity="0.7" TextTrimming="CharacterEllipsis"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="ColSize" Header="Розмір" Width="86">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding SizeText}" HorizontalAlignment="Right" Opacity="0.85"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="ColDate" Header="Змінено" Width="122">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding DateText}" Opacity="0.7"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn x:Name="ColAttr" Header="Атр." Width="48">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding AttrText}" Opacity="0.55" FontFamily="{StaticResource MonoFont}" FontSize="12"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Швидкий пошук (просто почніть друкувати) -->
            <Border Grid.Row="3" x:Name="QuickSearchBorder" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                    Margin="12" Padding="10,5" CornerRadius="6" Background="{StaticResource AccentBrush}" IsHitTestVisible="False">
                <TextBlock x:Name="QuickSearchText" Foreground="White"/>
            </Border>

            <!-- Статус -->
            <DockPanel Grid.Row="4" Margin="10,5,10,7">
                <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" FontSize="12" Foreground="{StaticResource TextDimBrush}"/>
                <TextBlock x:Name="StatusLeft" FontSize="12" Foreground="{StaticResource TextDimBrush}" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Grid>
    </Border>
</UserControl>
