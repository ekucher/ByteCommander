<!-- Темна палітра. Ключі мають збігатися з Colors.Light.xaml (це перевіряє тест ThemeTests). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#1B1C1F"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#222327"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#2A2B30"/>
    <SolidColorBrush x:Key="InputBrush" Color="#18191C"/>
    <SolidColorBrush x:Key="LineBrush" Color="#34363D"/>
    <SolidColorBrush x:Key="TextBrush" Color="#E4E5E9"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#8E919B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#4C8DFF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6A9FFF"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#2F4F86"/>
    <SolidColorBrush x:Key="SelectionInactiveBrush" Color="#34373E"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#2B2D33"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="#32343C"/>
    <SolidColorBrush x:Key="MarkedBrush" Color="#FFC857"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#E5534B"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#2C2E34"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#373942"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#25272C"/>
    <SolidColorBrush x:Key="ThumbBrush" Color="#4A4D56"/>
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="#666A76"/>
    <!-- Порівняння файлів і каталогів -->
    <SolidColorBrush x:Key="DiffAddedBrush" Color="#1F3A2A"/>
    <SolidColorBrush x:Key="DiffDeletedBrush" Color="#45242A"/>
    <SolidColorBrush x:Key="DiffChangedBrush" Color="#26334F"/>
    <SolidColorBrush x:Key="DiffChangedTextBrush" Color="#3E5799"/>
    <SolidColorBrush x:Key="DiffFillerBrush" Color="#202125"/>
    <!-- Кут між скролбарами у стандартному ScrollViewer -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#222327"/>
</ResourceDictionary>
