<!-- Світла палітра. Ключі мають збігатися з Colors.Dark.xaml (це перевіряє тест ThemeTests). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#F3F4F6"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="PanelAltBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="InputBrush" Color="#F7F8FA"/>
    <SolidColorBrush x:Key="LineBrush" Color="#D9DCE1"/>
    <SolidColorBrush x:Key="TextBrush" Color="#1F2328"/>
    <SolidColorBrush x:Key="TextDimBrush" Color="#656D76"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2F6FEB"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1F5BD6"/>
    <SolidColorBrush x:Key="SelectionBrush" Color="#CFE0FF"/>
    <SolidColorBrush x:Key="SelectionInactiveBrush" Color="#E6E8EC"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#EEF0F3"/>
    <SolidColorBrush x:Key="TabActiveBrush" Color="#E8EEFB"/>
    <SolidColorBrush x:Key="MarkedBrush" Color="#B35C00"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#CF222E"/>
    <SolidColorBrush x:Key="ControlBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="ControlHoverBrush" Color="#F0F2F5"/>
    <SolidColorBrush x:Key="ControlPressedBrush" Color="#E4E7EB"/>
    <SolidColorBrush x:Key="ThumbBrush" Color="#C4C9D1"/>
    <SolidColorBrush x:Key="ThumbHoverBrush" Color="#A2A9B4"/>
    <!-- Кут між скролбарами у стандартному ScrollViewer -->
    <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#FFFFFF"/>
</ResourceDictionary>
